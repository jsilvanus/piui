{
  "name": "@piecosystem/piui",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "description": "Unified atomic and molecular UI component library for the Pi Broadcast Ecosystem (picontrol, piagent, pimatrix)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js"
    },
    "./molecules": {
      "types": "./dist/molecules/index.d.ts",
      "import": "./dist/molecules/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-catalog.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "catalog": "tsc -p tsconfig.json && node scripts/generate-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "src",
    "catalog.html"
  ],
  "pi": {
    "service": "piui",
    "displayName": "piui",
    "layer": "+1 Presentation Plane",
    "kind": "library"
  }
}
